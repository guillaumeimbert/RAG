# raguesslighter configuration template
# Copy to .env and adjust. .env is gitignored; this file is committed.

# =============================================================================
# PostgreSQL / pgvector (matches compose.yaml — change both if you rename)
# =============================================================================
DATABASE_URL=postgresql://raguesslighter:raguesslighter@localhost:5432/raguesslighter

# =============================================================================
# Inference — any OpenAI-compatible server (vLLM, ninfer, llama.cpp, cloud).
# The app only speaks HTTP to this base URL; nothing else is assumed.
# =============================================================================
# Examples:
#   vLLM:       http://localhost:8000/v1
#   llama.cpp:  http://localhost:8080/v1
#   ninfer:     http://localhost:11500/v1
#   OpenAI:     https://api.openai.com/v1
OPENAI_BASE_URL=http://localhost:8000/v1
# Local servers usually ignore the key, but must be non-empty
OPENAI_API_KEY=not-needed
# Optional: serve embeddings from a different server. When absent, the
# chat endpoint/key above are reused.
#OPENAI_EMBED_BASE_URL=http://192.168.1.21:1234/v1
#OPENAI_EMBED_API_KEY=not-needed
LLM_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text
# MUST match the embedding column dimension in schema/0001_init.sql
EMBEDDING_DIM=2560

# =============================================================================
# SEC EDGAR — fair access policy (https://www.sec.gov/os/fair-access)
# Static user agent with contact info, max 10 requests/second. No API key.
#
# Verified endpoints (2026-08):
#   browse-edgar  : the "current filings" page; &output=atom gives an Atom feed
#                   (sample of the current business day — NOT the complete set)
#   daily-index   : COMPLETE per-business-day filing index:
#                   /Archives/edgar/daily-index/YYYY/QTRn/sitemap.YYYYMMDD.xml
#                   (QTRn = calendar quarter; ~5000 accession numbers per day)
#   submissions   : full filing history per company, by CIK
#   search-index  : EDGAR full-text search API (date/form/text filters)
#   Archives      : static document store — the actual filing HTML, by accession
# =============================================================================
SEC_USER_AGENT=Your Name <you@example.com>
SEC_BROWSE_EDGAR_BASE=https://www.sec.gov/cgi-bin/browse-edgar
SEC_DAILY_INDEX_BASE=https://www.sec.gov/Archives/edgar/daily-index
SEC_SUBMISSIONS_BASE=https://data.sec.gov/submissions
SEC_FTS_BASE=https://efts.sec.gov/LATEST/search-index
SEC_ARCHIVES_BASE=https://www.sec.gov/Archives/edgar/data
# Ticker -> CIK resolution file (flat JSON object; "cik_str" is an int).
# Optional — defaults to https://www.sec.gov/files/company_tickers.json.
#SEC_COMPANY_TICKERS_URL=https://www.sec.gov/files/company_tickers.json
# Nightly bulk fallback (whole-universe submissions, 1.56 GB, republished ~03:00 ET):
#   https://www.sec.gov/Archives/edgar/daily-index/bulkdata/submissions.zip
# See docs/adr/ADR-001-ingest-discovery.md for the full source analysis.
# Forms to ingest (comma-separated). Default = core periodic/event disclosure.
# "ALL" to include registration statements (S-1, 424B...), Schedules 13D/13G,
# Forms 3/4/5, etc. — that is ~5000 filings/day vs a few hundred for this set.
FORMS=10-K,10-K/A,10-Q,10-Q/A,8-K,8-K/A,20-F,20-F/A,6-K

# =============================================================================
# Chunking & retrieval
# =============================================================================
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=8