# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "RAG over SEC EDGAR filings: OCaml + Postgres/pgvector + any OpenAI-compatible inference server"
description: """
Ingests SEC EDGAR filings through the official public APIs (daily-index
  master file, per-CIK submissions JSON, static Archives documents), chunks
  the documents and embeds them through an OpenAI-compatible HTTP API
  (vLLM, ninfer, llama.cpp or a cloud provider), stores the vectors in
  PostgreSQL/pgvector and answers questions with grounded retrieval.
  Inference is configured entirely through .env; there are no
  in-process model dependencies."""
maintainer: ["Guillaume Imbert <imbert.guillaume@gmail.com>"]
authors: ["Guillaume Imbert <imbert.guillaume@gmail.com>"]
tags: ["rag" "edgar" "sec" "pgvector"]
homepage: "https://github.com/guillaumeimbert/raguesslighter"
doc: "https://github.com/guillaumeimbert/raguesslighter"
bug-reports: "https://github.com/guillaumeimbert/raguesslighter/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {= "5.5.0"}
  "caqti" {= "2.3.2"}
  "caqti-driver-postgresql" {= "2.3.0"}
  "caqti-lwt" {= "2.3.2"}
  "cmdliner"
  "cohttp"
  "cohttp-lwt"
  "cohttp-lwt-unix"
  "lwt_ssl"
  "http"
  "lwt"
  "lwt_ppx"
  "pg_query"
  "ppxlib"
  "re"
  "uri"
  "yojson"
  "zlib"
  "base"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/guillaumeimbert/raguesslighter.git"
x-maintenance-intent: ["(latest)"]
